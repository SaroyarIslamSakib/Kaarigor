@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<main class="container provider-wrap">
    <div class="row g-4 align-items-stretch justify-content-center">

        <!-- Info panel -->
        <div class="col-lg-5 d-none d-lg-block">
            <div class="provider-info">
                <h1>Welcome back to <span>Kaarigor</span></h1>
                <p>Log in to manage your bookings and find skilled providers near you.</p>

                <ul class="provider-points">
                    <li><i class="bi bi-calendar-check"></i><div><strong>Track your bookings</strong><span>See upcoming and past services in one place.</span></div></li>
                    <li><i class="bi bi-geo-alt"></i><div><strong>Local providers</strong><span>Find skilled people in your district.</span></div></li>
                    <li><i class="bi bi-patch-check"></i><div><strong>Trusted and verified</strong><span>Book providers with verified profiles.</span></div></li>
                </ul>
            </div>
        </div>

        <!-- Form -->
        <div class="col-lg-6">
            <div class="provider-card">
                <h2>Login to your account</h2>
                <p class="text-muted mb-4">Welcome back! Please choose how you'd like to log in.</p>

                <!-- Social login -->
                <div class="social-login two-col">
                    <form method="post" asp-controller="Account" asp-action="ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl">
                        <input type="hidden" name="provider" value="Google" />
                        <button type="submit" class="btn-social btn-google">
                            <i class="bi bi-google"></i>Google
                        </button>
                    </form>

                    <form method="post" asp-controller="Account" asp-action="ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl">
                        <input type="hidden" name="provider" value="Facebook" />
                        <button type="submit" class="btn-social btn-facebook">
                            <i class="bi bi-facebook"></i>Facebook
                        </button>
                    </form>
                </div>

                <div class="divider-text">or login with email</div>

                <!-- Email login -->
                <form asp-area="" asp-controller="Account" asp-action="Login"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      id="loginForm" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com"
                               autocomplete="username" aria-required="true" autofocus />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" placeholder="Enter your password"
                                   autocomplete="current-password" aria-required="true" />
                            <button class="btn btn-toggle-pass" type="button" data-toggle-password="#Password"
                                    aria-label="Show or hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check mb-0">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>
                        <a href="#" class="link-brand small">Forgot password?</a>
                    </div>

                    <button id="loginSubmit" type="submit" class="btn btn-brand w-100 py-2">Login</button>
                </form>

                <!-- Create account -->
                <p class="text-center text-muted small mt-4 mb-0">
                    New to Kaarigor?
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-brand">Create an account</a>
                </p>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.querySelector(this.getAttribute('data-toggle-password'));
                var icon = this.querySelector('i');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });
    </script>
}
