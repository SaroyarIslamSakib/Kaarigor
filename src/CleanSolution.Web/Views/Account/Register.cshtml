@model RegisterModel
@{
    ViewData["Title"] = "Register";
    // Layout সরিয়ে দেওয়া হয়েছে: এখন Become a Provider পেইজের মতো মূল _Layout ব্যবহার হবে
}

<main class="container provider-wrap">
    <div class="row g-4 align-items-stretch justify-content-center">

        <!-- Info panel -->
        <div class="col-lg-5 d-none d-lg-block">
            <div class="provider-info">
                <h1>Find trusted help with <span>Kaarigor</span></h1>
                <p>Create your account in under a minute and book skilled service providers near you.</p>

                <ul class="provider-points">
                    <li><i class="bi bi-lightning-charge"></i><div><strong>Quick sign up</strong><span>Just your email and a password to get started.</span></div></li>
                    <li><i class="bi bi-geo-alt"></i><div><strong>Local providers</strong><span>Find skilled people in your district.</span></div></li>
                    <li><i class="bi bi-patch-check"></i><div><strong>Verified work</strong><span>Check ratings and verification before you book.</span></div></li>
                </ul>
            </div>
        </div>

        <!-- Form -->
        <div class="col-lg-6">
            <div class="provider-card">
                <h2>Create your account</h2>
                <p class="text-muted mb-4">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="link-brand">Login</a>
                </p>

                <form asp-area="" asp-controller="Account" asp-action="Register"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      id="registerForm" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    @* UserName property থাকলে আনকমেন্ট করো
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Full Name</label>
                        <input asp-for="UserName" class="form-control" placeholder="e.g., Rahim Uddin" autocomplete="name" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    *@

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com"
                               autocomplete="username" aria-required="true" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" placeholder="At least 8 characters"
                                   autocomplete="new-password" aria-required="true" />
                            <button class="btn btn-outline-secondary" type="button" data-toggle-password="#Password"
                                    aria-label="Show or hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter your password"
                                   autocomplete="new-password" aria-required="true" />
                            <button class="btn btn-outline-secondary" type="button" data-toggle-password="#ConfirmPassword"
                                    aria-label="Show or hide confirm password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" id="terms-conditions" name="terms" value="true" class="form-check-input" required />
                        <label for="terms-conditions" class="form-check-label">
                            I agree to the <a href="#" class="link-brand">Terms &amp; Privacy</a>
                        </label>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-brand w-100 py-2">Create Account</button>
                </form>

                <!-- External logins -->
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="d-flex align-items-center gap-3 my-4">
                        <hr class="flex-grow-1 m-0" />
                        <span class="text-muted small">or continue with</span>
                        <hr class="flex-grow-1 m-0" />
                    </div>

                    <form id="external-account" asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl" method="post"
                          class="d-flex justify-content-center gap-2 flex-wrap">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-secondary"
                                    name="provider" value="@provider.Name"
                                    title="Sign up using your @provider.DisplayName account">
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                }

                <p class="small text-muted mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Want to offer services instead?
                    <a asp-controller="Home" asp-action="BeProvider" class="link-brand">Become a provider</a>
                </p>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.querySelector(this.getAttribute('data-toggle-password'));
                var icon = this.querySelector('i');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });
    </script>
}
