@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero -->
<header class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <h1>Find <span class="hl">Trusted</span> Skilled Workers Near You.</h1>
                <p class="lead">Electricians, AC &amp; fridge repair, home cleaning, tutors and more. Compare verified providers in your area, check their reviews, and book in minutes.</p>

                <form class="search-box" onsubmit="return false;">
                    <select aria-label="Division">
                        <option value="">Select division</option>
                        <option>Dhaka</option>
                        <option>Chattogram</option>
                        <option>Rajshahi</option>
                        <option>Khulna</option>
                        <option>Barishal</option>
                        <option>Sylhet</option>
                        <option>Rangpur</option>
                        <option>Mymensingh</option>
                    </select>
                    <input type="text" placeholder="What service do you need?" aria-label="Service">
                    <button class="btn btn-brand" type="submit"><i class="bi bi-search me-1"></i>Find Provider</button>
                </form>

                <div class="quick-tags">
                    Popular:
                    <a href="#">Electrician</a><a href="#">AC Repair</a><a href="#">Home Cleaning</a><a href="#">Tutor</a>
                </div>
            </div>

            <div class="col-lg-5">
                <!-- Sample provider card (illustrative) -->
                <div class="hero-visual">
                    <div class="pro-card">
                        <div class="pro-top">
                            <div class="pro-avatar"><i class="bi bi-person-fill"></i></div>
                            <div>
                                <strong>Rahim Uddin</strong>
                                <small><i class="bi bi-geo-alt"></i> Electrician, Gazipur</small>
                            </div>
                            <span class="pro-badge"><i class="bi bi-patch-check-fill"></i> Verified</span>
                        </div>
                        <div class="pro-rating">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                            <span class="ms-1">4.8 &middot; 96 reviews</span>
                        </div>
                        <div class="pro-tags"><span>Fan fitting</span><span>House wiring</span><span>AC servicing</span></div>
                        <a href="#" class="btn btn-brand w-100">Book now</a>
                    </div>
                    <span class="float-chip chip-1"><i class="bi bi-shield-check me-1"></i>ID verified</span>
                    <span class="float-chip chip-2"><i class="bi bi-lightning-charge me-1"></i>Quick response</span>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Stats (sample numbers: replace with real data from your API / ViewModel) -->
<section class="stats-wrap">
    <div class="container">
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-patch-check"></i></div>
                    <div><p class="stat-num">12,480</p><p class="stat-label">Verified Providers</p></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
                    <div><p class="stat-num">86,215</p><p class="stat-label">Completed Bookings</p></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-grid"></i></div>
                    <div><p class="stat-num">48</p><p class="stat-label">Service Categories</p></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-geo-alt"></i></div>
                    <div><p class="stat-num">64</p><p class="stat-label">Districts Covered</p></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories -->
<section id="categories" class="section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Browse Service Categories</h2>
            <p class="section-sub">Pick a category to see skilled workers available in your area.</p>
        </div>
        <div class="row g-4">
            <div class="col-6 col-md-4 col-lg-2"><a class="cat-card" asp-area="" asp-controller="service" asp-action="details"><i class="bi bi-lightning-charge"></i>Electrical</a></div>
            <div class="col-6 col-md-4 col-lg-2"><a class="cat-card" href="#"><i class="bi bi-snow2"></i>AC Repair</a></div>
            <div class="col-6 col-md-4 col-lg-2"><a class="cat-card" href="#"><i class="bi bi-ev-front"></i>Fridge &amp; Appliances</a></div>
            <div class="col-6 col-md-4 col-lg-2"><a class="cat-card" href="#"><i class="bi bi-house-heart"></i>Home Cleaning</a></div>
            <div class="col-6 col-md-4 col-lg-2"><a class="cat-card" href="#"><i class="bi bi-droplet"></i>Plumbing</a></div>
            <div class="col-6 col-md-4 col-lg-2"><a class="cat-card" href="#"><i class="bi bi-mortarboard"></i>Tutoring</a></div>
        </div>
    </div>
</section>

<!-- How it works -->
<section id="how" class="section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">How Kaarigor Works</h2>
            <p class="section-sub">From searching to review, everything happens in one place.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3 step"><div class="step-no">1</div><h5>Select your location</h5><p>Choose your division, district, thana and area to see services available near you.</p></div>
            <div class="col-md-6 col-lg-3 step"><div class="step-no">2</div><h5>Find a provider</h5><p>Search or browse a category, then filter by rating, experience, price and availability.</p></div>
            <div class="col-md-6 col-lg-3 step"><div class="step-no">3</div><h5>Check and book</h5><p>View their profile, work record and reviews. Chat, call, or send a booking request.</p></div>
            <div class="col-md-6 col-lg-3 step"><div class="step-no">4</div><h5>Rate the work</h5><p>After the job is done, leave a rating and review to help other customers.</p></div>
        </div>
    </div>
</section>

<!-- Trust -->
<section id="trust" class="trust">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Hire With Confidence</h2>
            <p class="section-sub">Every provider on Kaarigor goes through checks before they appear on the platform.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3"><div class="trust-item"><i class="bi bi-person-vcard"></i><div><h6>ID Verification</h6><p>NID or other ID checked by our admin team.</p></div></div></div>
            <div class="col-md-6 col-lg-3"><div class="trust-item"><i class="bi bi-phone"></i><div><h6>Phone OTP</h6><p>Every provider's number is confirmed by OTP.</p></div></div></div>
            <div class="col-md-6 col-lg-3"><div class="trust-item"><i class="bi bi-clipboard-data"></i><div><h6>Background Report</h6><p>Total jobs, complaints and on-time completion rate.</p></div></div></div>
            <div class="col-md-6 col-lg-3"><div class="trust-item"><i class="bi bi-chat-square-heart"></i><div><h6>Genuine Reviews</h6><p>Only customers with a completed booking can review.</p></div></div></div>
        </div>
    </div>
</section>

<!-- Provider CTA -->
<section id="join" class="container">
    <div class="cta text-center">
        <h2 class="section-title text-white">Are you a skilled worker?</h2>
        <p class="mb-4">Create your profile, list your skills and rates, show your past work, and get new customers in your area.</p>
        <a asp-area="" asp-controller="home" asp-action="beprovider" class="btn">Become a Provider</a>
    </div>
</section>
