@{
    Layout = null;
    ViewData["Title"] ??= "Provider Dashboard – Kaarigor";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="~/css/landing.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/provider.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/provider-profile.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="pp-body">

    <!-- Provider Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="logo" href="#"><i class="bi bi-tools"></i> Kaarigor<small>কারিগর</small></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="nav">
                <ul class="navbar-nav align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link active" href="#"><i class="bi bi-person-circle me-1"></i>My Profile</a></li>
                    <li class="nav-item"><a class="nav-link" href="#my-services"><i class="bi bi-briefcase me-1"></i>My Services</a></li>
                    <li class="nav-item">
                        <a class="nav-link" href="#bookings">
                            <i class="bi bi-calendar-check me-1"></i>Bookings
                            <span class="badge rounded-pill pp-badge">3</span>
                        </a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="#reviews"><i class="bi bi-star me-1"></i>Reviews</a></li>
                    <li class="nav-item dropdown ms-lg-3 mt-2 mt-lg-0">
                        <a class="btn btn-login dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person me-1"></i>Rahim Uddin
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-area="provider" asp-controller="profile" asp-action="manage"><i class="bi bi-gear me-2"></i>Manage Profile</a></li>
                            <li><a class="dropdown-item" asp-area="provider" asp-controller="service" asp-action="create"><i class="bi bi-plus-circle me-2"></i>Create Service</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer>
        <div class="container text-center">&copy; @DateTime.UtcNow.Year Kaarigor. All rights reserved.</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
