@{
    Layout = "~/Areas/Provider/Views/Shared/_ProviderLayout.cshtml";
    ViewData["Title"] = "Create Service";

    var categories = new[] { "Electrical", "AC Repair", "Fridge & Appliances", "Home Cleaning", "Plumbing", "Tutoring", "Other" };
    var divisions = new[] { "Dhaka", "Chattogram", "Rajshahi", "Khulna", "Barishal", "Sylhet", "Rangpur", "Mymensingh" };
    var days = new[] { "Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri" };
}

<main class="container pp-wrap">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="#" class="link-brand">My Profile</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create Service</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- Basic info -->
                <section class="pp-card">
                    <div class="pp-card-head"><h2>Service details</h2></div>

                    <div class="mb-3">
                        <label for="Title" class="form-label">Service title</label>
                        <input type="text" id="Title" name="Title" class="form-control" maxlength="80"
                               placeholder="e.g., Ceiling fan installation" required />
                    </div>

                    <div class="mb-3">
                        <label for="Category" class="form-label">Category</label>
                        <select id="Category" name="Category" class="form-select" required>
                            <option value="">Select an option</option>
                            @foreach (var c in categories)
                            {
                                <option>@c</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <textarea id="Description" name="Description" class="form-control" rows="4" maxlength="600"
                                  placeholder="What work do you do, and what tools or parts do you bring?" required></textarea>
                        <div class="form-text">Up to 600 characters.</div>
                    </div>

                    <div class="mb-0">
                        <label for="ExperienceYears" class="form-label">Experience in this service (years)</label>
                        <input type="number" id="ExperienceYears" name="ExperienceYears" class="form-control pp-narrow"
                               min="0" max="60" placeholder="e.g., 6" required />
                    </div>
                </section>

                <!-- Pricing -->
                <section class="pp-card">
                    <div class="pp-card-head"><h2>Price</h2></div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="RateType" class="form-label">Charged</label>
                            <select id="RateType" name="RateType" class="form-select" required>
                                <option value="Visit">Per visit</option>
                                <option value="Hour">Per hour</option>
                                <option value="Job">Per job</option>
                                <option value="Month">Per month</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label for="MinRate" class="form-label">From</label>
                            <div class="input-group">
                                <span class="input-group-text">৳</span>
                                <input type="number" id="MinRate" name="MinRate" class="form-control" min="0" step="50" required />
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <label for="MaxRate" class="form-label">To (optional)</label>
                            <div class="input-group">
                                <span class="input-group-text">৳</span>
                                <input type="number" id="MaxRate" name="MaxRate" class="form-control" min="0" step="50" />
                            </div>
                        </div>
                    </div>
                    <div class="form-text mt-2">This is an approximate rate. You can agree on the final price with the customer.</div>
                </section>

                <!-- Location -->
                <section class="pp-card">
                    <div class="pp-card-head"><h2>Where you work</h2></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="Division" class="form-label">Division</label>
                            <select id="Division" name="Division" class="form-select" required>
                                <option value="">Select an option</option>
                                @foreach (var d in divisions)
                                {
                                    <option>@d</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="District" class="form-label">District</label>
                            <select id="District" name="District" class="form-select" required disabled>
                                <option value="">Select division first</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="Thana" class="form-label">Thana</label>
                            <input type="text" id="Thana" name="Thana" class="form-control" placeholder="e.g., Tongi" required />
                        </div>
                        <div class="col-md-6">
                            <label for="Areas" class="form-label">Areas you cover</label>
                            <input type="text" id="Areas" name="Areas" class="form-control" placeholder="e.g., Station Road, Board Bazar" />
                            <div class="form-text">Separate areas with commas.</div>
                        </div>
                    </div>
                </section>

                <!-- Availability -->
                <section class="pp-card">
                    <div class="pp-card-head"><h2>When you are available</h2></div>
                    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Available days">
                        @foreach (var d in days)
                        {
                            <input type="checkbox" class="btn-check" id="day-@d" name="Days" value="@d" autocomplete="off" />
                            <label class="btn btn-outline-secondary btn-sm pp-day" for="day-@d">@d</label>
                        }
                    </div>
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <label for="FromTime" class="form-label">From</label>
                            <input type="time" id="FromTime" name="FromTime" class="form-control" value="09:00" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label for="ToTime" class="form-label">To</label>
                            <input type="time" id="ToTime" name="ToTime" class="form-control" value="18:00" required />
                        </div>
                    </div>
                </section>

                <!-- Photos -->
                <section class="pp-card">
                    <div class="pp-card-head"><h2>Work photos</h2><span class="small text-muted">Optional</span></div>
                    <label for="Photos" class="pp-drop">
                        <i class="bi bi-images"></i>
                        <span>Choose photos of your past work</span>
                        <small>JPG or PNG, up to 5 photos, 2 MB each</small>
                    </label>
                    <input type="file" id="Photos" name="Photos" accept="image/png,image/jpeg" multiple hidden />
                    <div id="photoPreview" class="pp-previews"></div>
                </section>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="IsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label" for="IsActive">Show this service to customers</label>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-brand px-4">Save service</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Tips -->
        <div class="col-lg-4 d-none d-lg-block">
            <aside class="pp-card pp-tips">
                <h2>Tips for a good listing</h2>
                <ul>
                    <li><i class="bi bi-check2-circle"></i><span>Use a clear title that says exactly what you do.</span></li>
                    <li><i class="bi bi-check2-circle"></i><span>Mention the tools, parts or warranty you offer.</span></li>
                    <li><i class="bi bi-check2-circle"></i><span>Add real photos of finished work to earn trust.</span></li>
                    <li><i class="bi bi-check2-circle"></i><span>Keep your available days and hours up to date.</span></li>
                </ul>
            </aside>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        var districts = {
            "Dhaka": ["Dhaka", "Faridpur", "Gazipur", "Gopalganj", "Kishoreganj", "Madaripur", "Manikganj", "Munshiganj", "Narayanganj", "Narsingdi", "Rajbari", "Shariatpur", "Tangail"],
            "Chattogram": ["Bandarban", "Brahmanbaria", "Chandpur", "Chattogram", "Cumilla", "Cox's Bazar", "Feni", "Khagrachhari", "Lakshmipur", "Noakhali", "Rangamati"],
            "Rajshahi": ["Bogura", "Chapainawabganj", "Joypurhat", "Naogaon", "Natore", "Pabna", "Rajshahi", "Sirajganj"],
            "Khulna": ["Bagerhat", "Chuadanga", "Jashore", "Jhenaidah", "Khulna", "Kushtia", "Magura", "Meherpur", "Narail", "Satkhira"],
            "Barishal": ["Barguna", "Barishal", "Bhola", "Jhalokathi", "Patuakhali", "Pirojpur"],
            "Sylhet": ["Habiganj", "Moulvibazar", "Sunamganj", "Sylhet"],
            "Rangpur": ["Dinajpur", "Gaibandha", "Kurigram", "Lalmonirhat", "Nilphamari", "Panchagarh", "Rangpur", "Thakurgaon"],
            "Mymensingh": ["Jamalpur", "Mymensingh", "Netrokona", "Sherpur"]
        };

        var division = document.getElementById('Division');
        var district = document.getElementById('District');
        division.addEventListener('change', function () {
            var list = districts[this.value] || [];
            district.innerHTML = '<option value="">' + (list.length ? 'Select an option' : 'Select division first') + '</option>';
            list.forEach(function (d) {
                var o = document.createElement('option');
                o.textContent = d;
                district.appendChild(o);
            });
            district.disabled = list.length === 0;
        });

        var photos = document.getElementById('Photos');
        var preview = document.getElementById('photoPreview');
        photos.addEventListener('change', function () {
            preview.innerHTML = '';
            var files = Array.from(this.files);
            if (files.length > 5 || files.some(function (f) { return f.size > 2 * 1024 * 1024; })) {
                alert('Please choose up to 5 photos, 2 MB each.');
                this.value = '';
                return;
            }
            files.forEach(function (f) {
                var img = document.createElement('img');
                img.src = URL.createObjectURL(f);
                img.alt = f.name;
                preview.appendChild(img);
            });
        });
    </script>
}
